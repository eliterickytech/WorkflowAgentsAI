# EditorConfig - Padrão de formatação para WorkflowAgentsAI
# https://editorconfig.org

root = true

# Padrão para todos os arquivos
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Arquivos Markdown
[*.md]
charset = utf-8
end_of_line = crlf
indent_size = 2
trim_trailing_whitespace = false  # Permite espaços para quebras de linha

# PowerShell
[*.{ps1,psm1,psd1}]
charset = utf-8
end_of_line = crlf
indent_size = 4

# YAML
[*.{yaml,yml}]
charset = utf-8
end_of_line = lf
indent_size = 2

# JSON
[*.json]
charset = utf-8
end_of_line = lf
indent_size = 2

# Gherkin (BDD)
[*.feature]
charset = utf-8
end_of_line = lf
indent_size = 2

# C# e .NET
[*.cs]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

# TypeScript/JavaScript
[*.{ts,js,tsx,jsx}]
charset = utf-8
end_of_line = lf
indent_size = 2

# HTML
[*.{html,htm}]
charset = utf-8
end_of_line = lf
indent_size = 2

# XML
[*.{xml,csproj,props,targets}]
charset = utf-8
end_of_line = crlf
indent_size = 2

# Python
[*.py]
charset = utf-8
end_of_line = lf
indent_size = 4

# Shell scripts
[*.sh]
charset = utf-8
end_of_line = lf
indent_size = 2

# Batch files
[*.{bat,cmd}]
charset = utf-8
end_of_line = crlf
indent_size = 2
