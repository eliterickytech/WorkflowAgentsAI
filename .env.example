# Provider and model
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI (use if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Feature flags for orchestrators
USE_CREWAI=0
USE_AUTOGEN=0

# Optional runtime context
# SPRINT define a sprint alvo (ex.: 01)
# OUTPUT_ACTIVITY define a activity alvo (ex.: rn0001)
# PROJECT_NAME define o nome do projeto
SPRINT=
OUTPUT_ACTIVITY=
PROJECT_NAME=

# Paths (opcional)
# WORKFLOW_AGENTS_ROOT força o diretório base dos artefatos/copied files.
# WORKFLOW_OUTPUT_ROOT permite direcionar data/out para outro local (por padrão usa <ROOT>\data\out).
WORKFLOW_AGENTS_ROOT=
WORKFLOW_OUTPUT_ROOT=
