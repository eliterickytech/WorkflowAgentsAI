  "integrationPoints": {
    "copilot": {
      "instructionsFile": ".github/copilot-instructions.md",
      "syncRequired": true
    },
    "mcp": {
      "supported": true,
      "configFile": "agents.index.json"
    }
  },
  "workflowPatterns": {
    "newFeature": [
      "product-owner",
      "requirements-analyst",
      "systems-architect",
      "expert-developer",
      "frontend-specialist",
      "testing-specialist"
    ],
    "frontendFeature": [
      "product-owner",
      "requirements-analyst",
      "frontend-specialist",
      "testing-specialist"
    ],
    "bugfix": [
      "expert-developer",
      "testing-specialist"
    ],
    "refactoring": [
      "systems-architect",
      "expert-developer",
      "testing-specialist"
    ],
    "uiRefactoring": [
      "frontend-specialist",
      "testing-specialist"
    ],
    "documentation": [
      "requirements-analyst"
    ]
  },
  "qualityGates": {
    "codeCompliance": {
      "dotnetVersion": ".NET Framework 4.8",
      "codingStandards": "SOLID principles, DDD patterns",
      "documentation": "XML comments required",
      "naming": "English for code, Portuguese for messages"
    },
    "testingStandards": {
      "minCoverage": "90%",
      "framework": "xUnit",
      "dataGeneration": "Bogus",
      "assertions": "FluentAssertions"
    },
    "architecturalConstraints": {
      "layerSeparation": "Clean Architecture",
      "persistence": "PostgreSQL primary",
      "messaging": "Asynchronous when applicable",
      "validation": "FluentValidation required"
    }
  }
}