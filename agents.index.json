{
  "agentsDirectory": "agents/manual/",
  "lastUpdated": "2025-10-15",
  "technologyStack": {
    "backend": ".NET 6.0",
    "frontend": "Angular",
    "node": ">=20.3"
  },
  "agents": [
    {
      "id": "product-owner",
      "name": "Product Owner Agent",
      "description": "Entende solicitações do cliente, define visão do produto e prioriza funcionalidades por valor de negócio.",
      "playbook": "agents/manual/product-owner.agent.md",
      "specialties": [
        "Análise de solicitações de cliente",
        "Definição de visão de produto",
        "Priorização por valor de negócio",
        "Comunicação com stakeholders",
        "Gestão de expectativas",
        "Critérios de aceitação"
      ],
      "inputs": [
        "Solicitações do cliente",
        "Requisitos de negócio",
        "Objetivos estratégicos",
        "Feedback de stakeholders",
        "Restrições de mercado"
      ],
      "outputs": [
        "Requirements Brief estruturado",
        "Business Context documentado",
        "User Stories priorizadas",
        "Critérios de aceitação definidos",
        "Roadmap de entregas",
        "Briefing para equipe técnica"
      ],
      "keyReferences": [
        "Scrum Guide",
        "Product Owner best practices",
        "Business analysis techniques",
        "Stakeholder management"
      ],
      "triggers": [
        "solicitacao cliente",
        "requisitos negocio",
        "product owner",
        "visao produto",
        "priorizacao",
        "stakeholder"
      ]
    },
    {
      "id": "roundtable-facilitator",
      "name": "Roundtable Facilitator Agent",
      "description": "Facilita alinhamento técnico entre especialistas, consolidando decisões e pendências por etapa.",
      "playbook": "agents/manual/roundtable-facilitator.agent.md",
      "specialties": [
        "Mediação técnica",
        "Consolidação de decisões",
        "Gestão de riscos e pendências",
        "Orquestração de agentes"
      ],
      "inputs": [
        "Saídas do Product Owner",
        "Contexto do projeto",
        "Questões dos especialistas"
      ],
      "outputs": [
        "Notas de alinhamento",
        "Decisões registradas",
        "Itens de ação por responsável"
      ],
      "keyReferences": [
        "docs/guia-agentes-individuais.md",
        "docs/fluxo-completo.md"
      ],
      "triggers": [
        "mesa redonda",
        "alinhamento",
        "pendencias",
        "decisoes"
      ]
    },
    {
      "id": "requirements-analyst",
      "name": "Requirements Analyst Agent",
      "description": "Transforma documentos de especificação em regras de negócio estruturadas seguindo padrão RN-00xx.md.",
      "playbook": "agents/manual/requirements-analyst.agent.md",
      "specialties": [
        "Análise de documentos docx/xlsx",
        "Extração de regras de negócio",
        "Criação de arquivos RN-00xx.md",
        "Mapeamento de dependências entre regras",
        "Validação de consistência terminológica"
      ],
      "inputs": [
        "Documentos .docx/.xlsx",
        "Contexto do domínio (anexos, bases, fórmulas)",
        "Número da regra (RN-00xx) alvo"
      ],
      "outputs": [
        "Arquivo RN-00xx.md estruturado",
        "Casos de teste derivados em formato tabular",
        "Mapeamento de dependências e impactos",
        "Validação cruzada com regras existentes"
      ],
      "keyReferences": [
        "references-data/",
        "data/out/"
      ],
      "triggers": [
        "analise de requisitos",
        "documento docx",
        "planilha xlsx",
        "regra RN-",
        "extracao de regras"
      ]
    },
