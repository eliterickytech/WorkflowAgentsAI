{
  "agentsDirectory": "agents/manual/",
  "lastUpdated": "2025-09-28",
  "agents": [
    {
      "id": "product-owner",
      "name": "Product Owner Agent",
      "description": "Entende solicitacoes do cliente, define visao do produto e prioriza funcionalidades por valor de negocio",
      "playbook": "agents/manual/product-owner.agent.md",
      "specialties": [
        "Analise de solicitacoes de cliente",
        "Definicao de visao de produto",
        "Priorizacao por valor de negocio",
        "Comunicacao com stakeholders",
        "Gestao de expectativas",
        "Criterios de aceitacao"
      ],
      "inputs": [
        "Solicitacoes do cliente",
        "Requisitos de negocio",
        "Objetivos estrategicos",
        "Feedback de stakeholders",
        "Restricoes de mercado"
      ],
      "outputs": [
        "Requirements Brief estruturado",
        "Business Context documentado",
        "User Stories priorizadas",
        "Criterios de aceitacao definidos",
        "Roadmap de entregas",
        "Briefing para equipe tecnica"
      ],
      "keyReferences": [
        "Scrum Guide",
        "Product Owner best practices",
        "Business analysis techniques",
        "Stakeholder management"
      ],
      "triggers": [
        "solicitacao cliente",
        "requisitos negocio",
        "product owner",
        "visao produto",
        "priorizacao",
        "stakeholder"
      ]
    },
    {
      "id": "requirements-analyst",
      "name": "Requirements Analyst Agent",
      "description": "Transforma documentos de especificacao (.docx, .xlsx) em regras de negocio estruturadas seguindo padrao RN-00xx.md",
      "playbook": "agents/manual/requirements-analyst.agent.md",
      "specialties": [
        "Analise de documentos docx/xlsx",
        "Extracao de regras de negocio",
        "Criacao de arquivos RN-00xx.md",
        "Mapeamento de dependencias entre regras",
        "Validacao de consistencia terminologica"
      ],
      "inputs": [
        "Documentos .docx em references-data/datas/business-rules-files/",
        "Planilhas .xlsx de validacao",
        "Contexto do dominio (anexos, bases, formulas)",
        "Numero da regra (RN-00xx) alvo"
      ],
      "outputs": [
        "Arquivo references-data/business-rules/RN-00xx.md estruturado",
        "Casos de teste derivados em formato tabular",
        "Mapeamento de dependencias e impactos",
        "Validacao cruzada com regras existentes"
      ],
      "keyReferences": [
        "references-data/pgdas-anexo-*.md",
        "references-data/business-rules/RN-0001.md",
        "references-data/datas/business-rules-files/",
        "references-data/datas/tables/validation-business-rules-files/"
      ],
      "triggers": [
        "analise de requisitos",
        "documento docx",
        "planilha xlsx",
        "regra RN-",
        "extracao de regras",
        "business rules"
      ]
    },
    {
      "id": "systems-architect",
      "name": "Systems Architect Agent",
      "description": "Projeta e estrutura arquitetura do sistema seguindo principios DDD, SOLID e Clean Architecture",
      "playbook": "agents/manual/systems-architect.agent.md",
      "specialties": [
        "Design orientado a dominio (DDD)",
        "Arquitetura em camadas (Domain/Application/Infra/Api)",
        "Definicao de bounded contexts e agregados",
        "Contratos de servicos e interfaces",
        "Estrategias de persistencia e integracao",
        "Padroes SOLID e Clean Architecture"
      ],
      "inputs": [
        "Especificacoes de regras de negocio (RN-00xx.md)",
        "Requisitos funcionais e nao-funcionais",
        "Restricoes tecnicas (.NET 4.8, PostgreSQL)",
        "Padroes arquiteturais existentes",
        "Terminologia do dominio (RBA, RBAA, etc.)"
      ],
      "outputs": [
        "Diagramas de contexto e componentes",
        "Estrutura de pastas e organizacao de projetos",
        "Definicao de entidades, agregados e value objects",
        "Contratos de servicos e interfaces",
        "Estrategia de testes por camada",
        "ADR (Architecture Decision Records)"
      ],
      "keyReferences": [
        "src/ (estrutura atual)",
        "Domain-Driven Design principles",
        "SOLID principles",
        "Clean Architecture patterns",
        ".NET Framework 4.8 constraints"
      ],
      "triggers": [
        "arquitetura",
        "design de sistema",
        "DDD",
        "bounded context",
        "entidades",
        "agregados",
        "adr"
      ]
    },
