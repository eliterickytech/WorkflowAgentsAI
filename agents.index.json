  "integrationPoints": {
    "copilot": {
      "instructionsFile": ".github/copilot-instructions.md",
      "syncRequired": true
    },
    "mcp": {
      "supported": true,
      "configFile": "agents.index.json"
    }
  },
  "workflowPatterns": {
    "newFeatureTDD": [
      "product-owner",
      "requirements-analyst",
      "systems-architect",
      "testing-specialist",
      "expert-developer",
      "testing-validator",
      "product-owner-final"
    ],
    "newFeature": [
      "product-owner",
      "requirements-analyst",
      "systems-architect",
      "expert-developer",
      "frontend-specialist",
      "testing-specialist"
    ],
    "frontendFeature": [
      "product-owner",
      "requirements-analyst",
      "frontend-specialist",
      "testing-specialist"
    ],
    "bugfixTDD": [
      "testing-specialist",
      "expert-developer",
      "testing-validator"
    ],
    "bugfix": [
      "expert-developer",
      "testing-specialist"
    ],
    "refactoring": [
      "systems-architect",
      "expert-developer",
      "testing-specialist"
    ],
    "uiRefactoring": [
      "frontend-specialist",
      "testing-specialist"
    ],
